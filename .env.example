# MongoDB connection string. Defaults to a local database if unset.
# Using Glossa Galore's Atlas cluster: same string, with /scribist as the database name.
DATABASE_URL=mongodb://127.0.0.1:27017/scribist

# Signs the login tokens (JWTs). Required in production: any long random string,
# e.g. `openssl rand -hex 32`.
SECRET=

# Optional: shows "Continue with Google" on the sign-in page. It's a client ID,
# not a secret. Add this site's address to the OAuth client's Authorized JavaScript origins.
GOOGLE_CLIENT_ID=
